{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "ox": ["./node_modules/ox/_types/index.d.ts"],
      "ox/*": ["./node_modules/ox/_types/core/*", "./node_modules/ox/_types/*"]
    },
    "outDir": "./cjs/",
    "target": "ES2015",
    "allowJs": true,
    "declaration": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/*",
    "./tests/**/*.ts"
  ],
  "typedocOptions": {
    "entryPoints": [
      "./src/index.ts"
    ],
    "out": "docs"
  }
}
